# OpenAI / Vercel AI SDK (Phase 1b). Required — there is no default model.
# Copy this file to apps/playground/.env (Nuxt loads .env from the playground rootDir)
# and fill in real values. .env is gitignored. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: only if your provider is not api.openai.com.
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
