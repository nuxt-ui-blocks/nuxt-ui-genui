{
  "name": "@nuxt-ui-genui/chat-ui",
  "version": "0.1.0",
  "description": "Slot-complete Nuxt UI chat shell driven by @nuxt-ui-genui/chat — no transport, model or endpoint assumptions",
  "license": "MIT",
  "keywords": ["openui", "generative-ui", "chat", "nuxt-ui", "vue", "ai", "streaming"],
  "type": "module",
  "main": "./dist/index.js",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE"],
  "scripts": { "build": "unbuild", "typecheck": "vue-tsc --noEmit -p tsconfig.json", "test": "vitest run" },
  "dependencies": { "@nuxt-ui-genui/chat": "workspace:*" },
  "peerDependencies": { "@nuxt/ui": ">=4.0.0", "vue": ">=3.5.0" },
  "devDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.6.0",
    "unbuild": "^3.6.1",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
