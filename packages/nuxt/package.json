{
  "name": "@nuxt-ui-genui/nuxt",
  "version": "0.1.0-alpha.1",
  "description": "Nuxt module and Vue plugin for the Nuxt GenUI generative-UI framework",
  "license": "MIT",
  "keywords": ["openui", "generative-ui", "nuxt", "nuxt-ui", "vue", "module", "ai"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
      "types": "./dist/module.d.mts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./runtime/*": "./dist/runtime/*",
    "./vue-plugin": {
      "import": "./dist/runtime/plugin.js",
      "types": "./dist/runtime/plugin.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node ./scripts/ensure-components-dist.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@openuidev/lang-core": "^0.4.1",
    "@openuidev/vue-lang": "^0.4.2",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "nuxt": ">=4.1.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": { "optional": true }
  },
  "devDependencies": {
    "@nuxt-ui-genui/components": "workspace:*",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^3.17.0",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/charts": "^1.5.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "nuxt": "~4.4.8",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vitest-environment-nuxt": "^1.0.1",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12"
  }
}
