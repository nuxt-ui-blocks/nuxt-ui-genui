# Copy to .env (gitignored) and fill in to enable LIVE mode.
# LIVE is the default: the playground calls the model instead of serving static
# demo programs. Without a key the chat route answers 503 (no silent mock).

# OpenAI-compatible gateway to call. Defaults to a local default gateway.
# The stock local gateway at http://127.0.0.1:8317/v1 expects a key.
GENAI_API_KEY=
GENAI_BASE_URL=http://127.0.0.1:8317/v1
GENAI_MODEL=gemini-3.5-flash-lite

# Set to 1 to serve the deterministic demo programs instead of calling the model
# (no network calls, not AI). The mock wins over a configured key.
GENAI_MOCK=

# Legacy alias for GENAI_MOCK=1 - kept so older setups keep working.
GENAI_LIVE=
